@baseUrl = http://localhost:8080
@token = REPLACE_AFTER_LOGIN
@deviceId = android-device-001

### Health
GET {{baseUrl}}/health

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin.rawdah",
  "pin": "123456",
  "deviceId": "{{deviceId}}"
}

### Register device
POST {{baseUrl}}/api/v1/devices/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "deviceId": "{{deviceId}}",
  "deviceName": "Android Test",
  "appVersion": "2.4.0"
}

### Push idempotent operation
POST {{baseUrl}}/api/v1/sync/push
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "operationId": "e4d73aa6-d63c-4a90-9be0-128f2b65b2f2",
  "deviceId": "{{deviceId}}",
  "entityType": "PAYMENT",
  "entityId": "PAY-001",
  "action": "UPSERT",
  "clientCreatedAt": "2026-07-16T00:00:00Z",
  "payload": {
    "receiptNo": "AB-20260716-0001",
    "amount": 5000
  }
}

### Pull changes
GET {{baseUrl}}/api/v1/sync/pull?afterSequence=0&limit=200
Authorization: Bearer {{token}}
