<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#F6F1E7</item>
        <item name="android:colorAccent">#1E73BE</item>
        <item name="android:statusBarColor">#102A43</item>
        <item name="android:navigationBarColor">#102A43</item>
        <item name="android:alertDialogTheme">@style/QatraLoginDialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="QatraLoginDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F6F1E7</item>
        <item name="android:colorAccent">#1E73BE</item>
        <item name="android:textColorPrimary">#102A43</item>
        <item name="android:textColorSecondary">#5C6F7E</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowElevation">18dp</item>
        <item name="android:buttonStyle">@style/QatraDialogButton</item>
        <item name="android:editTextStyle">@style/QatraLoginEditText</item>
    </style>

    <style name="QatraDialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#1E73BE</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QatraLoginEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">#102A43</item>
        <item name="android:textColorHint">#718493</item>
        <item name="android:backgroundTint">#1E73BE</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
</resources>
